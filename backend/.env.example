# Configuration locale du backend
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Connexion à PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/moeye_service_dev?schema=public

# Génère cette valeur avec la commande indiquée dans la documentation.
JWT_SECRET=REMPLACER_PAR_UN_SECRET_HEXADECIMAL_DE_64_CARACTERES

# Assistant IA (optionnel pour la connexion des utilisateurs)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Alternative OpenAI : choisir AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna