# Configuration locale du backend
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Connexion à PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/moeye_service_dev?schema=public

# Génère cette valeur avec la commande indiquée dans la documentation.
JWT_SECRET=REMPLACER_PAR_UN_SECRET_HEXADECIMAL_DE_64_CARACTERES

# Assistant IA (optionnel pour la connexion des utilisateurs)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Alternative OpenAI : choisir AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Paiement Wave (clés privées à configurer dans Render, jamais dans le frontend)
WAVE_API_KEY=
WAVE_REQUEST_SIGNING_SECRET=
WAVE_WEBHOOK_SECRET=
PUBLIC_FRONTEND_URL=https://moaye-service.vercel.app

# Envoi des e-mails de récupération de compte (à configurer dans l’environnement du backend)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
