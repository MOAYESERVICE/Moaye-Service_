{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MOAYE : démarrer le backend IA",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "moaye-backend",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*node --watch src/server.js.*",
          "endsPattern": "Serveur lancé sur http://localhost:4000"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
