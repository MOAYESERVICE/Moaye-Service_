{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MOAYE: Backend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "moaye-backend",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*node --watch src/server.js.*",
          "endsPattern": "Serveur lancé sur http://localhost:4000"
        }
      },
    },
    {
      "label": "MOAYE: Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false },
      "problemMatcher": {
        "owner": "moaye-frontend",
        "pattern": { "regexp": ".*" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*next dev.*",
          "endsPattern": "Ready in .*"
        }
      }
    },
    {
      "label": "MOAYE: Frontend lint",
      "type": "shell",
      "command": "npm run lint",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "MOAYE: Frontend build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "MOAYE: Backend tests",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    }
  ]
}
